{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "~/pw/support/*": ["./support/*"],
      // `paths` replaces rather than merges with the base config's, so `@/*` and
      // `~/shared/*` are repeated here to keep them working in tests.
      "@/*": ["../src/*"],
      "~/shared/*": ["../shared/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules"]
}

{
  "name": "specialingredientbass.com",
  "version": "1.0.0",
  "private": true,
  "description": "Special Ingredient Bass Music",
  "keywords": [
    "bass",
    "music"
  ],
  "homepage": "specialingredientbass.com",
  "bugs": {
    "url": "https://github.com/bvandrc/specialingredientbass.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvandrc/specialingredientbass.com.git"
  },
  "author": "Blake Vandercar",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "start": "pnpm dev",
    "dev": "vite --open",
    "build": "vite build",
    "preview": "pnpm build && vite preview --open",
    "preview:ci": "vite preview --strictPort",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "check": "pnpm format && pnpm ts:check && pnpm pw:ts:check",
    "format": "npx biome check . --fix",
    "ts:check": "tsc",
    "pw:ts:check": "tsc --project playwright/tsconfig.json",
    "__c2": "====================[ Playwright Testing ]=======================",
    "test:e2e": "pnpm pw:run --project=e2e",
    "test:a11y": "pnpm pw:run --project=a11y --project=a11y:mobile",
    "test:lighthouse": "pnpm pw:run --project=lighthouse",
    "test:lighthouse:production": "pnpm pw:run --project=lighthouse:production",
    "pw:run": "playwright test",
    "pw:open": "playwright test --ui",
    "pw:report": "playwright show-report playwright/results/html",
    "__c3": "====================[ Misc ]=====================================",
    "sandbox": "npx tsx ./sandbox.ts",
    "generate-playlist-json": "vite --open --config ./spotify-tools/vite.config.ts ./spotify-tools"
  },
  "dependencies": {
    "@fontsource/barlow": "^5",
    "@fontsource/outfit": "^5",
    "@fontsource/roboto-condensed": "^5",
    "@fortawesome/fontawesome-free": "^7",
    "@fortawesome/fontawesome-svg-core": "^7",
    "@fortawesome/free-brands-svg-icons": "^7",
    "@fortawesome/free-solid-svg-icons": "^7",
    "@fortawesome/react-fontawesome": "^3",
    "classnames": "^2",
    "es-toolkit": "^1",
    "react": "^18",
    "react-dom": "^18",
    "react-ga4": "^3",
    "react-masonry-css": "^1",
    "soundcloud-widget": "^0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@biomejs/biome": "^2",
    "@playwright/test": "^1",
    "@spotify/web-api-ts-sdk": "^1.2",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6",
    "axe-core": "^4",
    "lighthouse": "^13",
    "lighthouse-audit-utils": "^1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "^8",
    "vite-plugin-fs": "^1"
  }
}

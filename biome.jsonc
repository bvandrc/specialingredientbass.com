{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.jsonc"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        // wish we could use this but it doesn't work with tsconfig path aliases
        "noUndeclaredDependencies": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!conventions",
      "!!**/coverage",
      "!!**/dist",
      "!!graphics (non-website)", // huge SVG exports crash the Biome 2.5 project scanner (stack overflow)
      "!**/node_modules",
      "!!public/Logo Outlined.svg", // Inkscape export: Biome 2.6 lints its inline styles, which carry Inkscape-only properties
      "!**/playwright/results",
      "!!public/Logo Outlined.svg", // Inkscape export; Biome 2.5.15 lints its inline styles (Inkscape-only properties, a font with no generic fallback)
      "!!**/soundcloudWidget.js"
    ]
  }
}

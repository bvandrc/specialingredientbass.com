{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.jsonc"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        // wish we could use this but it doesn't work with tsconfig path aliases
        "noUndeclaredDependencies": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "overrides": [
    {
      // build/ runs at build time only; src/ takes nothing from it but types,
      // re-exported through src/types/, which holds nothing else.
      "includes": ["src/**", "!src/types/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/build/**"],
                    "message": "src/ takes only types from build/, re-exported through src/types/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!!conventions",
      "!!**/coverage",
      "!!**/dist",
      "!!graphics (non-website)", // huge SVG exports crash the Biome 2.5 project scanner (stack overflow)
      "!**/node_modules",
      "!!public/Logo Outlined.svg", // Inkscape export: Biome 2.6 lints its inline styles, which carry Inkscape-only properties
      "!**/playwright/results",
      "!!**/soundcloudWidget.js"
    ]
  }
}

{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.jsonc"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        // wish we could use this but it doesn't work with tsconfig path aliases
        "noUndeclaredDependencies": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "overrides": [
    {
      // build/ runs at build time only and never ships: what src/ needs from
      // it lives in shared/, which both import.
      "includes": ["src/**", "shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/build/**"],
                    "message": "build/ is build-time only; move what src/ needs into shared/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The reverse: src/ is the app, so what build/ needs from it lives in
      // shared/ too.
      "includes": ["build/**", "shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/**", "@/**"],
                    "message": "src/ is the app; move what build/ or shared/ needs into shared/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!!conventions",
      "!!**/coverage",
      "!!**/dist",
      "!!graphics (non-website)", // huge SVG exports crash the Biome 2.5 project scanner (stack overflow)
      "!**/node_modules",
      "!!public/Logo Outlined.svg", // Inkscape export: Biome 2.6 lints its inline styles, which carry Inkscape-only properties
      "!**/playwright/results",
      "!!**/soundcloudWidget.js"
    ]
  }
}
